# Development environment for `npm run dev`, applied by direnv.
#
# Both of these exist because of how Electron is obtained on this machine, not
# because of anything RomMix does. Nothing here is required to build or ship
# the app, and the file is a no-op on a host where Electron runs as npm
# installed it.

# NixOS cannot execute the generic-linux Electron binary that `npm install`
# downloads: there is no loader at the path it is linked against. The Electron
# from the system profile is used instead.
#
# It has to be ELECTRON_EXEC_PATH: electron-vite resolves the binary itself and
# reads only that variable. ELECTRON_OVERRIDE_DIST_PATH — the one the `electron`
# npm package documents — is never consulted, and is exported here only for
# other tooling that does respect it.
if electron_bin=$(command -v electron 2>/dev/null); then
  export ELECTRON_EXEC_PATH="$electron_bin"
  export ELECTRON_OVERRIDE_DIST_PATH="$(dirname "$electron_bin")"
fi

# Electron-based tooling exports this, and a child Electron inherits it: the
# app would start as plain Node, exit without a window, and report no error.
unset ELECTRON_RUN_AS_NODE
