{
  "name": "rommix",
  "version": "0.16.0-rc.1",
  "description": "Big Picture style front end for your own RomM server on Linux: browse your library, download a game, play it, and your saves go back to RomM",
  "license": "MIT",
  "author": "Benjamin Leclerc",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "desktopName": "be.bl_it.RomMix.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "preview:app": "vite --config vite.web.config.ts",
    "preview:web": "npm run build:site && vite preview --outDir out/site --host --port 5274",
    "screenshots": "vite build --config vite.web.config.ts && ./scripts/headless.sh electron scripts/screenshots.mjs",
    "build:site": "./scripts/build-site.sh",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./scripts/test-resolve.mjs --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"packaging/**/*.test.ts\"",
    "test:coverage": "node --import ./scripts/test-resolve.mjs --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-test-coverage --test-coverage-exclude=src/renderer/**/*.tsx --test-coverage-lines=96 --test-coverage-branches=88 --test-coverage-functions=89 \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"packaging/**/*.test.ts\"",
    "schema:fetch": "node scripts/fetch-openapi.mjs",
    "test:app": "./scripts/test-app.sh",
    "build": "npm run typecheck && electron-vite build",
    "pack:dir": "npm run build && electron-builder --linux dir",
    "package": "electron-builder --linux AppImage --publish never",
    "appimage": "npm run build && npm run package",
    "release": "release-it",
    "release:rc": "release-it --preRelease=rc",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "qrcode-generator": "^2.0.4",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "release-it": "^21.0.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
