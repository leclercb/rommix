{
  "name": "rommix",
  "version": "0.7.3",
  "description": "Big Picture style RomM launcher for Linux desktop, gamescope and Steam, with RetroDECK, EmuDeck, RetroArch, Eden and shadPS4 integration",
  "license": "MIT",
  "author": "Benjamin Leclerc",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.15"
  },
  "desktopName": "be.bl_it.RomMix.desktop",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "preview:app": "vite --config vite.web.config.ts",
    "preview:web": "npm run build:site && vite preview --outDir out/site --host --port 5274",
    "build:site": "./scripts/build-site.sh",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import ./scripts/test-resolve.mjs --experimental-transform-types --test \"src/**/*.test.ts\"",
    "build": "npm run typecheck && electron-vite build",
    "pack:dir": "npm run build && electron-builder --linux dir",
    "package": "electron-builder --linux AppImage --publish never",
    "appimage": "npm run build && npm run package",
    "release": "release-it"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "qrcode-generator": "^2.0.4",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "release-it": "^21.0.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
