{
  "name": "rommix",
  "version": "0.1.0",
  "description": "Big Picture style RomM launcher for Linux desktop, gamescope and Steam, with RetroDECK, RetroArch and Eden integration",
  "license": "MIT",
  "author": "Benjamin Leclerc",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"src/**/*.test.ts\"",
    "build": "npm run typecheck && electron-vite build",
    "pack:dir": "npm run build && electron-builder --linux dir",
    "flatpak": "./scripts/build-flatpak.sh"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "qrcode-generator": "^2.0.4",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
