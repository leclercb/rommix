{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "resolveJsonModule": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/config/**/*",
    "test/**/*",
    "packaging/**/*",
    "electron.vite.config.ts",
    "vite.web.config.ts"
  ]
}
