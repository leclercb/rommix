{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Tests run straight through Node's TypeScript stripping, which requires
    // explicit .ts specifiers on relative imports.
    "allowImportingTsExtensions": true,
    // No baseUrl: `paths` resolves relative to this file, and baseUrl is
    // deprecated as of TypeScript 7.
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/config/**/*",
    "electron.vite.config.ts",
    "vite.web.config.ts"
  ]
}
